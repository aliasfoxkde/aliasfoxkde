{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aliasfoxkde/aliasfoxkde/blob/main/schemas/projects.schema.json",
  "title": "Portfolio project catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "last_reviewed",
    "status_vocabulary",
    "projects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "owner": {
      "const": "aliasfoxkde"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "status_vocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "status",
          "summary",
          "featured"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "maintained",
              "active-development",
              "prototype",
              "experimental",
              "archived",
              "fork-or-mirror",
              "internal-support",
              "needs-review"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "featured": {
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "required": [
              "repository"
            ]
          },
          {
            "required": [
              "website"
            ]
          }
        ]
      }
    }
  }
}
